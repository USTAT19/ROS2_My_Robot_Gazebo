<launch>
    <let name="urdf_path" 
         value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro"/>

    <let name="gazebo_config_path" 
         value="$(find-pkg-share my_robot_bringup)/config/gazebo_bridge.yaml"/>     

    <let name="rviz_path"
        value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')"/>
    </node>
    
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(find-pkg-share my_robot_bringup)/worlds/gazebo_world1.sdf -r"/>
    </include>   





    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description"/>

    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_path)" />
    
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config_path)"/>
    </node>
    
    <node pkg="tf2_ros" exec="static_transform_publisher"
    args="0 0 0.22 0 0 0 base_footprint my_robot/base_footprint/lidar"
    name="lidar_tf_publisher"/>

    <node pkg="tf2_ros" exec="static_transform_publisher"
    args="0 0 0.1 0 0 0 base_footprint my_robot/base_footprint/imu"
    name="imu_tf_publisher"/>

</launch>